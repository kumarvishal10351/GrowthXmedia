# ElevateXMedia Environment Variables Template
# Copy this file to .env.local to configure your form destination

# Official Web3Forms Submission Endpoint (Free Plan)
VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit

# Web3Forms Access Key (Obtain your free access key at https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Notification email destination for direct email fallback
VITE_CONTACT_EMAIL=elevatexmedia.enquiry@gmail.com
